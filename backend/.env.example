# ScamShield Environment Configuration
# Project: ScamShield | Team: OBSIDIAN | INNOV12

PROJECT_NAME="ScamShield"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Primary: PostgreSQL
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/scamshield"

# Fallback: SQLite
SQLITE_FALLBACK_URL="sqlite:///./scamshield.db"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Trusted Brands Configuration
TRUSTED_BRANDS_PATH="app/config/trusted_brands.json"
